#!/usr/bin/env python3
"""Check the archives produced by CI without installing or publishing them."""
import hashlib
import json
from pathlib import Path
import zipfile

root = Path(__file__).resolve().parents[1]
manifest = json.loads((root / "manifest.json").read_text())
archives = sorted((root / "dist").glob("*.zip"))
if not archives:
    raise SystemExit("No plugin ZIP was produced.")
reports = []
for path in archives:
    with zipfile.ZipFile(path) as archive:
        assert archive.testzip() is None, "Archive CRC check failed"
        entries = archive.infolist()
        assert len({entry.filename for entry in entries}) == len(entries), "Duplicate ZIP member"
        for entry in entries:
            name = Path(entry.filename)
            assert not name.is_absolute() and ".." not in name.parts, "Unsafe ZIP member"
        manifests = [entry.filename for entry in entries if Path(entry.filename).name == "manifest.json"]
        assert len(manifests) == 1, "Expected one manifest"
        assert json.loads(archive.read(manifests[0])) == manifest, "Packaged manifest differs from source"
        assert path.stat().st_size <= 32 * 1024 * 1024, "Compressed package exceeds host limit"
        assert sum(entry.file_size for entry in entries) <= 64 * 1024 * 1024, "Expanded package exceeds host limit"
        assert all(entry.file_size <= 16 * 1024 * 1024 for entry in entries), "ZIP member exceeds host limit"
    digest = hashlib.sha256(path.read_bytes()).hexdigest()
    path.with_suffix(".zip.sha256").write_text(f"{digest}  {path.name}\n")
    reports.append({"package": path.name, "sha256": digest, "id": manifest["id"], "version": manifest["version"], "archive_check": "passed", "host_integration": "not_run_by_this_check"})
(root / "dist/package-check.json").write_text(json.dumps(reports, indent=2) + "\n")
print(json.dumps(reports, indent=2))
