#!/usr/bin/env python3
"""Read-only artist diagnostics. I print catalog IDs/statuses, never account data."""
import argparse
import json
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
from tidal_plugin.client import Client
from tidal_plugin.catalog import Catalog
from tidal_plugin.state import Cache, Failure

parser = argparse.ArgumentParser()
parser.add_argument("data", type=Path)
parser.add_argument("query")
args = parser.parse_args()
client = Client(args.data)
try:
    found = client.get("search/artists", {"query": args.query, "limit": 5})
    artists = found.get("items", [])
    print(json.dumps({"artists": [{"id": a.get("id"), "name": a.get("name")} for a in artists]}, ensure_ascii=False))
    for artist in artists[:2]:
        key = str(artist["id"])
        for tail, params in [("", None), ("/bio", None), ("/toptracks", {"limit":20}),
                             ("/albums", {"limit":30}), ("/albums", {"limit":30,"filter":"EPSANDSINGLES"}),
                             ("/albums", {"limit":30,"filter":"COMPILATIONS"}), ("/similar", {"limit":20})]:
            path = "artists/" + key + tail
            try:
                value = client.get(path, params)
                print(json.dumps({"path":path,"filter":(params or {}).get("filter"), "ok":True,
                                  "items":len(value.get("items", [])),"title":value.get("name")}, ensure_ascii=False))
            except Failure as error:
                print(json.dumps({"path":path,"filter":(params or {}).get("filter"),"ok":False,"status":error.status}))
        try:
            page = Catalog(client, Cache()).artist_page("artist:" + key)
            print(json.dumps({"page":key,"ok":True,"title":page["title"]},ensure_ascii=False))
        except Failure as error:
            print(json.dumps({"page":key,"ok":False,"status":error.status}))
except Failure as error:
    print(json.dumps({"ok":False,"status":error.status,"message":str(error)}))
    sys.exit(1)
