#!/usr/bin/env python3
"""Exercise only artist reads in the packaged RPC process, with isolated state."""
import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

parser = argparse.ArgumentParser()
parser.add_argument("package", type=Path)
parser.add_argument("data", type=Path)
parser.add_argument("artist")
args = parser.parse_args()
with tempfile.TemporaryDirectory(prefix="chilpa-artist-rpc-") as temporary:
    data = Path(temporary)
    shutil.copyfile(args.data / "account.json", data / "account.json")
    os.chmod(data / "account.json", 0o600)
    messages = [{"jsonrpc":"2.0","id":1,"method":"page.get","params":{"ref":"artist:"+args.artist}}]
    run = subprocess.run([str(args.package.resolve()/"plugin"), "--data-dir", temporary],
                         input="".join(json.dumps(m)+"\n" for m in messages), text=True,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=90)
    print(json.dumps({"exit":run.returncode,"stderr_bytes":len(run.stderr)}))
    for line in run.stdout.splitlines():
        response = json.loads(line)
        if "error" in response:
            print(json.dumps({"error":response["error"]}))
            raise SystemExit(1)
        page = response["result"]
        assert page["header"]["ref"] == "artist:" + args.artist
        print(json.dumps({"title":page["title"],"ref":page["header"]["ref"],
                          "shelves":{s["id"]:len(s.get("items",[])) for s in page["shelves"]}}))
