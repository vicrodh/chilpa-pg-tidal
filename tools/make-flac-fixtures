#!/usr/bin/env python3
"""Write the FLAC fragments the decoder tests read, with the reference PCM hash.

Each fixture is a stream header (fLaC and STREAMINFO) followed by frames, the
shape a DASH fragment has once its media payload is joined to the init
metadata. One fixture of each resolution starts at frame 0, another in the
middle of the stream. The reference samples come from the flac command line
tool; frame boundaries come from libFLAC itself.
"""
import ctypes as C
import ctypes.util
import hashlib
import json
import pathlib
import subprocess
import tempfile

out = pathlib.Path(__file__).resolve().parents[1] / "tests" / "fixtures"
out.mkdir(parents=True, exist_ok=True)
lib = C.CDLL(ctypes.util.find_library("FLAC"))
P = C.c_void_p
Write = C.CFUNCTYPE(C.c_int, P, P, C.POINTER(C.POINTER(C.c_int32)), P)
Error = C.CFUNCTYPE(None, P, C.c_int, P)
lib.FLAC__stream_decoder_new.restype = P
lib.FLAC__stream_decoder_init_file.argtypes = [P, C.c_char_p, Write, P, Error, P]
lib.FLAC__stream_decoder_get_decode_position.argtypes = [P, C.POINTER(C.c_uint64)]
lib.FLAC__stream_decoder_get_blocksize.argtypes = [P]
for name in ["process_until_end_of_stream", "finish", "delete"]:
    getattr(lib, "FLAC__stream_decoder_" + name).argtypes = [P]


def frames(path):
    """Byte offset where each frame starts, and its sample count."""
    decoder = lib.FLAC__stream_decoder_new()
    found, previous = [], [None]

    @Write
    def write(handle, frame, planes, _):
        position = C.c_uint64()
        lib.FLAC__stream_decoder_get_decode_position(handle, C.byref(position))
        found.append((position.value, lib.FLAC__stream_decoder_get_blocksize(handle)))
        return 0

    @Error
    def error(*_):
        raise SystemExit("libFLAC reported a decoding error")

    assert lib.FLAC__stream_decoder_init_file(decoder, str(path).encode(), write, None, error, None) == 0
    assert lib.FLAC__stream_decoder_process_until_end_of_stream(decoder)
    lib.FLAC__stream_decoder_finish(decoder)
    lib.FLAC__stream_decoder_delete(decoder)
    # The position is where the frame after the one just decoded begins.
    data = path.read_bytes()
    starts = [stream_header_end(data)] + [position for position, _ in found[:-1]]
    return [(start, count) for start, (_, count) in zip(starts, found)]


def stream_header_end(data):
    position = 4
    while True:
        last, size = data[position] & 0x80, int.from_bytes(data[position + 1:position + 4], "big")
        position += 4 + size
        if last:
            return position


def header(data):
    assert data[4] & 0x7F == 0 and int.from_bytes(data[5:8], "big") == 34
    return b"fLaC\x80\x00\x00\x22" + data[8:42]


manifest = []
with tempfile.TemporaryDirectory() as temporary:
    for rate, bits, seconds in [(44100, 16, 0.6), (96000, 24, 0.3)]:
        wav, flac = pathlib.Path(temporary, "in.wav"), pathlib.Path(temporary, "in.flac")
        subprocess.run(["sox", "-n", "-r", str(rate), "-b", str(bits), "-c", "2", str(wav), "synth", str(seconds),
                        "sine", "440", "pinknoise", "vol", "0.4"], check=True)
        subprocess.run(["flac", "-s", "-f", "-5", "--no-seektable", "--no-padding", "-T", "artist=", "-o", str(flac), str(wav)], check=True)
        data = flac.read_bytes()
        raw = subprocess.run(["flac", "-s", "-d", "-c", "--force-raw-format", "--endian=little", "--sign=signed", str(flac)],
                             check=True, capture_output=True).stdout
        width = 2 * bits // 8
        table = frames(flac)
        middle = len(table) // 2
        skipped = sum(count for _, count in table[:middle])
        for name, start, before in [("whole", table[0][0], 0), ("middle", table[middle][0], skipped)]:
            fixture = header(data) + data[start:]
            pcm = raw[before * width:]
            path = out / f"{name}-{rate}-{bits}.flac"
            path.write_bytes(fixture)
            manifest.append({"file": path.name, "rate": rate, "bits": bits, "frames": len(pcm) // width,
                             "pcm_sha256": hashlib.sha256(pcm).hexdigest()})
(out / "flac.json").write_text(json.dumps(manifest, indent=2) + "\n")
print(json.dumps(manifest, indent=2))
